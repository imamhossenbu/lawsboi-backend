# Copy to .env. Never commit .env: it holds the Supabase secret key and the mailbox password.

# --- Server
PORT=4000
# "development" prints readable logs and writes emails to the console when SMTP isn't set
NODE_ENV=development
# Browser origins allowed to call the API (comma-separated): the reader site and the admin panel
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Where the reader site and the admin panel live, for links inside emails
READER_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Supabase, the database only (Project settings → API keys)
SUPABASE_URL=https://xxxx.supabase.co
# The secret key: server only. It bypasses row level security, so it never leaves this API
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Sign-ins: the API signs its own tokens. At least 32 characters: `openssl rand -base64 48`
JWT_SECRET=
# How long an access token lasts (minutes) and how long a device stays signed in without use (days)
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# --- Ticket attachments on S3-compatible storage. Backblaze B2: the bucket's Endpoint (with https://), the region
# inside it, and an application key (keyID / applicationKey) with Read and Write on the bucket.
# Required in production; without them in development, uploads fail with a clear message
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Scheduler: cron-job.org calls /cron/tick with "Authorization: Bearer <CRON_SECRET>". Required in production.
# Leave empty in development: the API then runs the tick itself every minute
CRON_SECRET=

# --- Email (nodemailer over SMTP). With Gmail, SMTP_PASS is an app password, not the account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# What readers see in their inbox
EMAIL_FROM="Lawsboi <you@gmail.com>"
# Where readers' support tickets are copied (defaults to SMTP_USER)
SUPPORT_INBOX=

# --- First admin, for `npm run seed:admin`
ADMIN_EMAIL=admin@lawsboi.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Lawsboi Admin

# Direct Postgres connection (Project Settings → Database), for `npm run db:migrate` and `npm run db:types`. URL-encode the password.
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Google Gemini (aistudio.google.com), for the assistant's answers and the admin panel's AI menu
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
