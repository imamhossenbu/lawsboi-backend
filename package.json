{
  "name": "lawsboi-api",
  "version": "0.1.0",
  "private": true,
  "description": "The Lawsboi API: readers' accounts and support, and the admin panel's team and tickets, on Supabase.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:admin": "tsx --env-file=.env scripts/seed-admin.ts",
    "seed:plans": "tsx --env-file=.env scripts/seed-plans.ts",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --project-id ykjanlcuhgmazgzxdkqe --schema public > src/types/database.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "pino-pretty": "^13.2.0",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
